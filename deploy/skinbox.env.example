# Copy to /etc/skinbox/skinbox.env (systemd) or deploy/skinbox.env (docker compose),
# and fill in real values. chmod 600 — root-only read.
#
# DOCKER COMPOSE: start with
#     docker compose --env-file deploy/skinbox.env up -d
# The bare `docker compose up` will NOT see these. Compose interpolates ${VAR} in the
# compose file from the shell or a ROOT .env only — never from an `env_file:` entry, which
# supplies the CONTAINER and is read too late. Verified 2026-08-31: with the values in
# deploy/skinbox.env and nowhere else, `docker compose config` still fails with
# "required variable STRIPE_SECRET_KEY is missing a value".
#
# NOTE ON A DUMMY KEY: do not put a placeholder sk_live_ value here to get past the error.
# `isLive()` is only "a key is set and isn't the literal placeholder", so any plausible-
# looking key flips the service into LIVE mode, where it behaves as though real payments
# work right up until the first charge.

SPRING_PROFILES_ACTIVE=prod

# Database (Postgres)
#
# DB_PASSWORD is the one the COMPOSE FILE reads. It is interpolated into BOTH
# the db service's POSTGRES_PASSWORD and the app service's
# SPRING_DATASOURCE_PASSWORD, so the two can never drift apart. It is required —
# `docker compose` refuses to start without it, the same way it already refuses
# without STRIPE_SECRET_KEY. It used to default to the literal string `skinbox`
# on a database published to every interface of the host; both halves of that
# are fixed in docker-compose.yml, and this line is the half you must fill in.
#
# Note the distinction the header above draws: `--env-file` (what the documented
# deploy command passes) DOES feed ${VAR} interpolation, which is why setting
# DB_PASSWORD here works. The SPRING_DATASOURCE_* lines below are different —
# they are passed through to the CONTAINER, and are what a non-compose deploy
# (systemd, a managed Postgres) uses instead.
DB_PASSWORD=CHANGE_ME

SPRING_DATASOURCE_URL=jdbc:postgresql://db.internal:5432/skinbox
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=skinbox
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_DDL=validate
FLYWAY_ENABLED=true

# Stripe (live mode)
#
# THE PLACEHOLDERS DELIBERATELY DO NOT CARRY STRIPE'S PREFIXES. The required
# shape is documented in the comment; it is NOT in the value. This file used to
# ship `STRIPE_SECRET_KEY=sk_live_CHANGE_ME`, and a prefix is exactly what every
# guard in this codebase keys on:
#
#   - MoneyMode.ofKey() reads `sk_live_…` as LIVE (the prefix is the whole test —
#     it does not check length, on purpose: see MoneyModeSpec). So the unedited
#     example classifies the deployment as LIVE with no real key behind it.
#   - The header above warns not to put a placeholder sk_live_ value here to get
#     past the compose error. This file was doing precisely that, in the file
#     whose entire job is to be copied.
#   - Worse, setting it at all defeats the compose-level guard the header cites:
#     `docker compose` refuses to start when STRIPE_SECRET_KEY has no value, and
#     `sk_live_CHANGE_ME` IS a value.
#
# `CHANGE_ME` with no prefix classifies MoneyMode.INDETERMINATE instead, which
# authorises nothing on ANY profile — no Stripe call, no simulated credit, no
# dev scaffolding — and ProdConfigValidator refuses to boot on it. Note an EMPTY
# value would be worse here, not better: a blank key is MoneyMode.SIMULATED,
# which is the one classification that authorises the in-process fabricated
# deposit. Fail INDETERMINATE, never SIMULATED.
#
# Pinned by DeployExampleHasNoLiveShapedPlaceholderSpec.
#
# STRIPE_SECRET_KEY      must start with sk_live_ or rk_live_ (rk_ preferred)
# STRIPE_PUBLISHABLE_KEY must start with pk_live_
# STRIPE_WEBHOOK_SECRET  must start with whsec_
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_PUBLISHABLE_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_SUCCESS_URL=https://skinbox.market/?deposit=success
STRIPE_CANCEL_URL=https://skinbox.market/?deposit=cancel

# Steam
STEAM_API_KEY=
STEAM_REALM=https://skinbox.market/
STEAM_RETURN_URL=https://skinbox.market/api/auth/steam/return

# Admin bootstrap — comma-separated Steam ID64s that auto-get ADMIN role on
# login. THERE IS NO LONGER A DEFAULT: application.yml ships an empty value, so
# an unset var means NOBODY is auto-promoted. You must name the owner here.
#
# This is a STANDING grant, not a one-time bootstrap — promoteBootstrapAdmin
# runs on every login, so a listed ID is re-promoted even after revokeAdmin.
# Removing an ID from this list does NOT demote anyone: the role is persisted in
# STEAM_USERS.ROLE. To actually demote, remove the ID here AND call revokeAdmin.
#
# ===== BURNED ADMIN IDENTITY -- READ BEFORE YOU FILL THIS IN =====
#
# Two Steam IDs were committed to this repository as admin defaults -- one in
# application.yml, one in docker-compose.yml's `:-` fallback -- and both are now
# PUBLIC on origin/main. Published history is not being rewritten, so they
# cannot be unpublished, and they must never be used as an admin identity again
# -- not here and not on any other deployment. Anyone who can read the public
# history knows them, so listing one below is the same as having no admin
# control at all.
#
# The digits are recorded in deploy/RUNBOOK.md under the heading
# "burned admin identity", and nowhere on the launch surface, so that grepping
# the launch surface for a bare Steam ID stays a decisive check. Look them up
# there and confirm that what you are about to paste is neither of them.
#
# Put a Steam ID you control and that has never been published here.
ADMIN_BOOTSTRAP_STEAM_IDS=CHANGE_ME

# Security
CORS_ALLOWED_ORIGINS=https://skinbox.market
COOKIE_SECURE=true
# Lax (not Strict) — Steam OpenID and Stripe Checkout redirect the browser
# back to skinbox.market from their domains. SameSite=Strict blocks the
# session cookie on those cross-site top-level navigations, causing the
# session to appear lost after login/deposit.
COOKIE_SAME_SITE=lax
SECURITY_HSTS=true
SECURITY_CSRF=true
SECURITY_VERBOSE_ERRORS=false

# Lock down everything not needed in prod
H2_CONSOLE=false
SWAGGER_ENABLED=false
# Actuator is disabled by default via management.server.port=-1 — do NOT
# expose the actuator servlet on the public port in prod. If you need a
# management port behind a firewall, set ACTUATOR_PORT=9090.
# ACTUATOR_PORT=9090

# Logging
LOG_FILE=/var/log/skinbox/skinbox.log

# CSR goodwill credit cap in USD
CSR_CREDIT_CAP=25.00

# Email — Resend SMTP (or any SMTP-compatible relay)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS=true
APP_EMAIL_FROM=noreply@skinbox.market
APP_EMAIL_FROM_NAME=SkinBox
APP_PUBLIC_URL=https://skinbox.market

# One-click-unsubscribe HMAC signing secret (RFC 8058). MANDATORY in prod —
# application-prod.yml maps `app.unsubscribe.secret: ${APP_UNSUBSCRIBE_SECRET}`
# with NO default, so the app FAILS TO BOOT if this is unset (fail-fast, by
# design). EmailService's @Value fallback is the committed dev placeholder
# `dev-only-do-not-use-in-production-7f3a9c` — if that ever reached prod,
# anyone reading the public source could forge unsubscribe tokens for ANY
# user's email and silently mute their notifications. Generate a strong
# random value and NEVER reuse the placeholder:
#   openssl rand -base64 48
APP_UNSUBSCRIBE_SECRET=CHANGE_ME_openssl_rand_base64_48

# Sentry — error tracking + performance
SENTRY_DSN=https://abc123@o123456.ingest.us.sentry.io/789
SENTRY_ENV=production

# Trade escrow auto-release window (days). Default is 8 days.
TRADE_AUTO_RELEASE_DAYS=8

# Batch 719 — Money-movement caps. Both default to $5,000 / 24h at the
# application layer; override here per ops risk appetite. These caps are
# per-user rolling 24h windows enforced server-side; the frontend
# surfaces remaining headroom on the deposit/withdrawal forms.
WALLET_DAILY_WITHDRAWAL_CAP=5000
SBOX_STRIPE_DAILY_DEPOSIT_CAP=5000

# Batch 719 — Other operational knobs previously only in application.yml
# defaults. Listed here for ops visibility — tune per incident or growth
# pattern without a code change.
#
# Trade: seller has N days to accept before the trade auto-cancels (batch 502).
TRADE_SELLER_RESPONSE_DAYS=3
# Offer: PENDING offers auto-decline after N days of inactivity.
OFFER_AUTO_DECLINE_DAYS=7
# Support: WAITING_USER tickets auto-resolve after N days if the user
# doesn't reply (keeps the active queue bounded).
SUPPORT_AUTO_RESOLVE_WAITING_USER_DAYS=14
# Notifications: read notifications are purged after N days (batch 513).
NOTIFICATIONS_RETAIN_READ_DAYS=180

# JVM tuning (systemd unit passes these through automatically)
# Must match what the app binds (application.yml -> server.port:
# ${SERVER_PORT:8082}), the Dockerfile HEALTHCHECK, and deploy/nginx.conf's
# proxy_pass. This said 8080 while everything else used 8082.
SERVER_PORT=8082
