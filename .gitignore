# Local dev artefacts that should never be committed. boot.log is the
# nohup target for bootRun; gradle.properties holds machine-local Gradle
# JVM tuning; *.output / .tmp_* are leftover agent/test artefacts. Each
# was actively dirtying `git status` and risked being accidentally
# included in a bulk `git add .`.
boot.log
gradle.properties
*.output
.tmp_*

# Environment / secrets
.env
*.env
.env.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node (if ever added)
node_modules/

# Docker
docker-compose.override.yml

# Claude memory (project-local, not committed)
.claude/
.playwright-mcp/
cycle*.png
*.png
