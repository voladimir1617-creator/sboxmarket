# ---------------------------------------------------------------------------
# sboxmarket Steam bot sidecar — environment template.
# Copy to ".env" (which is gitignored) and fill in REAL values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Steam bot account credentials (dedicated account, NOT a personal one) ---
STEAM_BOT_USERNAME=your_bot_steam_login
STEAM_BOT_PASSWORD=your_bot_steam_password

# --- Steam Guard Mobile Authenticator secrets (see README "Extracting secrets") ---
# shared_secret  -> used to generate the 5-char Steam Guard login code (TOTP)
# identity_secret -> used to auto-confirm outgoing trade offers / market actions
STEAM_BOT_SHARED_SECRET=base64_shared_secret_here
STEAM_BOT_IDENTITY_SECRET=base64_identity_secret_here

# --- Steam Web API key for the bot account (https://steamcommunity.com/dev/apikey) ---
# Optional: if omitted, steam-tradeoffer-manager will obtain/derive one after web login.
STEAM_BOT_API_KEY=

# --- Shared bearer token between this sidecar and the Spring backend ---
# Must EXACTLY match BOT_API_TOKEN configured for SteamTradeBotService on the backend.
# Generate a long random string, e.g.:  openssl rand -hex 32
BOT_API_TOKEN=change_me_long_random_shared_token

# --- HTTP server binding (keep on localhost / private network) ---
BOT_HOST=127.0.0.1
BOT_PORT=4000

# --- Steam app / inventory context (s&box = 590830, default context = 2) ---
STEAM_BOT_APP_ID=590830
STEAM_BOT_CONTEXT_ID=2

# --- Tuning (milliseconds) ---
STEAM_BOT_POLL_INTERVAL_MS=15000
STEAM_BOT_CONFIRM_RETRY_MS=20000
