# ---------------------------------------------------------------------------
# sboxmarket Steam bot sidecar — environment template.
# Copy to ".env" (which is gitignored) and fill in REAL values. NEVER commit .env.
#
# The sidecar does NOT auto-load this file. Start it with:
#     node --env-file=.env index.js
# (or inject the env via systemd EnvironmentFile= / docker --env-file / pm2).
# Running plain `node index.js` or `npm start` with a .env sitting next to it
# reads NOTHING from this file and every variable below will report as missing.
#
# Every REQUIRED variable is checked at startup, before Steam login and before
# the HTTP port binds. Missing, blank, or still-placeholder values are listed
# by name and the process exits non-zero. The placeholder values shipped below
# are rejected on purpose — copying this file without editing it will not boot.
# ---------------------------------------------------------------------------

# --- Steam bot account credentials (dedicated account, NOT a personal one) ---
# REQUIRED, no default. The account you created in README step 1.
# STEAM_BOT_USERNAME is the Steam *login* name, not the display/profile name.
STEAM_BOT_USERNAME=your_bot_steam_login
STEAM_BOT_PASSWORD=your_bot_steam_password

# --- Steam Guard Mobile Authenticator secrets (see README "Extracting secrets") ---
# REQUIRED, no default. Both are base64 strings from the bot account's mobile
# authenticator, extracted in README step 3 (SDA maFile, or the Android
# Steamguard-<steamid> file). Treat them like passwords.
#   shared_secret   -> generates the Steam Guard login code (TOTP). Login is
#                      impossible without it.
#   identity_secret -> auto-confirms outgoing trade offers and market actions.
#                      Without it every offer the bot sends stalls unconfirmed.
STEAM_BOT_SHARED_SECRET=base64_shared_secret_here
STEAM_BOT_IDENTITY_SECRET=base64_identity_secret_here

# --- Steam Web API key for the bot account (https://steamcommunity.com/dev/apikey) ---
# OPTIONAL, default empty — and currently UNUSED. steam-tradeoffer-manager
# derives its own Web API key from the login session during setCookies(); there
# is no parameter to hand it one. Leaving this blank is the correct setup. If
# you set it anyway the sidecar logs a one-line notice and ignores the value.
STEAM_BOT_API_KEY=

# --- Shared bearer token between this sidecar and the Spring backend ---
# REQUIRED, no default. Sent by the backend as `Authorization: Bearer <token>`
# on every request except /health. Must EXACTLY match the BOT_API_TOKEN the
# backend uses for SteamTradeBotService, or every backend call gets a 401.
# Generate a long random string, e.g.:  openssl rand -hex 32
BOT_API_TOKEN=change_me_long_random_shared_token

# --- HTTP server binding (keep on localhost / private network) ---
# OPTIONAL. BOT_HOST default 127.0.0.1; BOT_PORT default 4000 (1-65535).
# Whatever you set here must match the backend's STEAM_BOT_BASE_URL.
# Do not bind this to a public interface — the bearer token is the only guard.
BOT_HOST=127.0.0.1
BOT_PORT=4000

# --- Steam app / inventory context (s&box = 590830, default context = 2) ---
# OPTIONAL. STEAM_BOT_APP_ID default 590830 (s&box); STEAM_BOT_CONTEXT_ID
# default 2 (the standard Steam inventory context). Both must be whole numbers.
# Leave these alone unless you are pointing the sidecar at a different game.
STEAM_BOT_APP_ID=590830
STEAM_BOT_CONTEXT_ID=2

# --- Tuning (milliseconds) ---
# OPTIONAL, whole numbers. Defaults shown.
#   POLL_INTERVAL_MS  -> how often steam-tradeoffer-manager polls offer state.
#   CONFIRM_RETRY_MS  -> how often the confirmation checker retries mobile
#                        confirmations.
# Lowering these sharply invites Steam rate limits (surfaced as RATE_LIMITED).
STEAM_BOT_POLL_INTERVAL_MS=15000
STEAM_BOT_CONFIRM_RETRY_MS=20000
