+/* CSFLOAT-1:1 PARITY ship #127260 — `.wallet-error` validation block typography
+   ────────────────────────────────────────────────────────────────────────────
+   Anchor: csfloat's mat-mdc-form-field-error (the canonical Material 3
+   destructive-text primitive) measured live via getComputedStyle:
+       font-size       12px
+       font-weight     400  (regular, NOT 600)
+       line-height     20px
+       letter-spacing  0.4px
+       color           rgb(235, 75, 75)
+       margin/padding  0 (text); wrapper padding 0 16px
+       font-family     Roboto, "Helvetica Neue", sans-serif
+   sboxmarket's `.wallet-error` is rendered as a *block notice* (with a
+   tinted background + 1px destructive border + radius), not a bare line of
+   helper text. We keep the block envelope but realign typography to match
+   csfloat's destructive-text primitive verbatim: 12 / 20 / 400 / 0.4px /
+   rgb(235,75,75). This regularises 17+ render sites (Profile trade-URL save,
+   wallet form, 2FA enroll/regen/disable, report dialogs, listing edits,
+   bulk-adjust, staff modals, csfloat-modals) under one consistent error
+   typography that reads as a Material destructive helper, not a heavy chip.
+   The inline-hint sibling (.wallet-inline-hint) gets the same body
+   typography (12/20/400/0.4px) for visual consistency, minus the colour. */
+body .wallet-error {
+  font-family: Roboto, "Helvetica Neue", sans-serif !important;
+  font-size: 12px !important;
+  font-weight: 400 !important;
+  line-height: 20px !important;
+  letter-spacing: 0.4px !important;
+  color: rgb(235, 75, 75) !important;
+  background: rgba(235, 75, 75, 0.08) !important;
+  border: 1px solid rgba(235, 75, 75, 0.30) !important;
+  border-radius: 6px !important;
+  padding: 8px 12px !important;
+  display: flex !important;
+  align-items: flex-start !important;
+  gap: 8px !important;
+  transition: background-color 150ms cubic-bezier(0.4, 0, 0.2, 1),
+              border-color 150ms cubic-bezier(0.4, 0, 0.2, 1) !important;
+}
+body .wallet-inline-hint {
+  font-family: Roboto, "Helvetica Neue", sans-serif !important;
+  font-size: 12px !important;
+  font-weight: 400 !important;
+  line-height: 20px !important;
+  letter-spacing: 0.4px !important;
+  color: rgb(158, 167, 177) !important;
+  padding: 8px 12px !important;
+  border-radius: 6px !important;
+}
+/* Override the prior #11405 buyorder variant so the destructive colour and
+   weight stays consistent with the canonical Material primitive — the
+   earlier ship pinned font-weight:600 + #f87171, both wrong vs measured. */
+body .buyorder-form .wallet-error {
+  background: rgba(235, 75, 75, 0.08) !important;
+  border: 1px solid rgba(235, 75, 75, 0.30) !important;
+  color: rgb(235, 75, 75) !important;
+  font-weight: 400 !important;
+  letter-spacing: 0.4px !important;
+  line-height: 20px !important;
+}
+/* END CSFLOAT-1:1 PARITY ship #127260 */
