+/* =====================================================================
+   Ship #127160 — /settings "Mute notification types" chip strip parity
+   pass against CSFloat /search mat-button-toggle-group reference.
+
+   CONTEXT
+     SettingsModal renders a row "Mute notification types" with six
+     inline category buttons (TRADES / AUCTIONS / OFFERS / MATCHES /
+     WALLET / OTHER) reusing class `.wallet-tx-filter-chip`. The chips
+     share the class with the wallet transactions filter strip, so we
+     scope this override exclusively via the unique `title` attributes
+     that the mute toggle sets:
+        title="Click to mute this category"   (audible / "active")
+        title="Muted — click to unmute"        (muted / inactive)
+     Wallet-tx chips use a different title pattern, never matched here.
+
+   MEASURED ON CSFloat /search (mat-button-toggle-group.state):
+     group.h            = 38   (inline-flex)
+     group.bg           = rgba(193,206,255,0.04)
+     group.radius       = 7px
+     group.border       = none
+     toggle.h           = 32
+     toggle.radius      = 4px
+     active.bg          = rgba(193,206,255,0.04)        ← brand tint 4 %
+     inactive.bg        = transparent
+     label.padding      = 0 12px
+     label.line-height  = 32px
+     label.font-size    = 14px
+     active.font-weight = 500
+     inactive.weight    = 400
+     transition         = all (Material default ≈ cubic-bezier(.4,0,.2,1))
+
+   WHY ONLY chip-level (not wrapping the strip in a 38h pill)
+     The strip lives inside a Row() with `justifyContent: flex-end` and
+     `maxWidth: 320`. Wrapping it in a colored 38h pill would conflict
+     with that auto-flow and steal width from the description column on
+     small modal widths. CSFloat's pill IS only present because every
+     toggle in the group sits flush; sboxmarket's strip already wraps,
+     so each chip carries its own pill geometry. Result: the chip
+     looks identical to one toggle out of CSFloat's group.
+
+   STATE SEMANTICS (from modals.js:3030-3040)
+     muted.has(opt.id)          → muted (faded + struck)
+     !muted.has(opt.id)         → audible / "active" (full opacity)
+     The label text itself flips between "Trades" and "Muted · Trades"
+     when toggled, so we don't need an icon swap.
+
+   APPEND-only, !important everywhere — final cascade.
+   ===================================================================== */
+
+/* ---- Mute notif chips: shared geometry (audible + muted) ------------ */
+.wallet-tx-filter-chip[title*="mute this category"],
+.wallet-tx-filter-chip[title*="Muted —"] {
+  /* Lock to the 32 h × 4 r Material toggle box. The wallet-tx baseline
+     is 5/10 padding which gives 30 px tall — push to 32. */
+  height: 32px !important;
+  min-height: 32px !important;
+  padding: 0 12px !important;
+  line-height: 32px !important;
+  font-size: 12px !important;
+  font-weight: 500 !important;
+  letter-spacing: 0 !important;
+  border-radius: 4px !important;
+  border: 1px solid transparent !important;
+  /* Material standard motion */
+  transition:
+    background-color 200ms cubic-bezier(0.4, 0, 0.2, 1),
+    color            200ms cubic-bezier(0.4, 0, 0.2, 1),
+    border-color     200ms cubic-bezier(0.4, 0, 0.2, 1),
+    opacity          200ms cubic-bezier(0.4, 0, 0.2, 1) !important;
+}
+
+/* ---- AUDIBLE / "active" (title = "Click to mute this category") ----- */
+.wallet-tx-filter-chip[title*="mute this category"] {
+  /* Solid token-ink label, brand-tint 4 % background. Mirrors the
+     mat-button-toggle-checked state from /search. */
+  background: rgba(193, 206, 255, 0.04) !important;
+  color: rgb(232, 234, 238) !important;          /* near-white ink */
+  border-color: rgba(255, 255, 255, 0.06) !important;  /* hairline */
+  text-decoration: none !important;
+  opacity: 1 !important;
+}
+.wallet-tx-filter-chip[title*="mute this category"]:hover {
+  background: rgba(193, 206, 255, 0.08) !important;
+  border-color: rgba(255, 255, 255, 0.10) !important;
+  color: rgb(255, 255, 255) !important;
+}
+
+/* ---- MUTED state (title = "Muted —") -------------------------------- */
+.wallet-tx-filter-chip[title*="Muted —"] {
+  /* Per spec: 0.5 opacity + struck-through label. The label already
+     starts with "Muted · " so the strikethrough reads as cancel
+     intent, not as a price. */
+  background: transparent !important;
+  color: rgb(158, 167, 177) !important;          /* --ink-2 token */
+  border-color: rgba(255, 255, 255, 0.04) !important;
+  opacity: 0.5 !important;
+  text-decoration: line-through !important;
+  text-decoration-color: rgba(158, 167, 177, 0.6) !important;
+  text-decoration-thickness: 1px !important;
+  text-underline-offset: 0 !important;
+}
+.wallet-tx-filter-chip[title*="Muted —"]:hover {
+  /* Lift the muted chip toward the audible look on hover so re-enable
+     intent is obvious — opacity climbs but the strike stays so the
+     state is still legible mid-hover. */
+  background: rgba(255, 255, 255, 0.03) !important;
+  border-color: rgba(255, 255, 255, 0.08) !important;
+  color: rgb(193, 206, 255) !important;          /* brand fade */
+  opacity: 0.8 !important;
+}
+
+/* ---- Active press feedback ------------------------------------------- */
+.wallet-tx-filter-chip[title*="mute this category"]:active,
+.wallet-tx-filter-chip[title*="Muted —"]:active {
+  /* Existing :active rule on .wallet-tx-filter-chip applies a
+     translateY(1px) press; preserve that and add a brief brand-tint
+     flash so the toggle feel matches Material ripple intent without
+     pulling in the actual ripple element. */
+  background: rgba(35, 123, 255, 0.16) !important;
+  transition:
+    background-color 80ms cubic-bezier(0.4, 0, 0.2, 1),
+    transform        80ms ease-out !important;
+}
+
+/* ---- Focus ring stays accessible (line-2 ring already global) ------- */
+.wallet-tx-filter-chip[title*="mute this category"]:focus-visible,
+.wallet-tx-filter-chip[title*="Muted —"]:focus-visible {
+  /* Existing global focus rule sets a brand outline; ensure it sits
+     inside the chip box rather than expanding it (offset 0). */
+  outline-offset: 0 !important;
+}
