# Gradle build output — the Dockerfile rebuilds inside a fresh container.
build/
.gradle/

# Git history — never belongs in a build context (bloats it, can leak refs).
.git/
.github/

# Node — node_modules/ lives at the repo root (frontend tooling) and is huge;
# the bootJar bundles no node output, so it must never enter the build context.
node_modules/

# IDE + editor
.idea/
.vscode/
*.iml

# Local database files — we never want the dev H2 state baked into an image.
data/

# Runtime logs
logs/
*.log

# Local scratch / agent artefacts that litter the repo root — ship scripts,
# run logs, compiled probes, patch dumps, the valuer zip. None are build
# inputs; excluding them keeps the context lean and avoids leaking dumps.
_*
*.class
*.patch
*.zip
csfloat-styles.css

# Docs + dev tooling that the runtime image never needs.
*.md
extension/
design/
.playwright-mcp/

# Memory from the AI assistant session
.claude/

# OS noise
.DS_Store
Thumbs.db

# Env files (secrets never go into an image)
.env
.env.*
